{
  "manifest_version": 3,
  "name": "Spark Reply — Draft replies for Slack",
  "version": "1.0.4",
  "version_name": "1.0.4-rc.1",
  "minimum_chrome_version": "116",
  "description": "Draft replies from selected Slack messages. Choose your language, review suggestions, and insert a draft. Your own OpenAI key.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.openai.com/*"],
  "content_scripts": [{
    "matches": ["https://app.slack.com/client/*"],
    "js": ["spark.js"],
    "run_at": "document_idle"
  }],
  "background": {"service_worker": "background.js"},
  "options_ui": {"page": "panel.html", "open_in_tab": false},
  "action": {"default_title": "Spark Reply", "default_popup": "panel.html", "default_icon": {"16":"icons/icon-16.png","32":"icons/icon-32.png","48":"icons/icon-48.png","128":"icons/icon-128.png"}},
  "icons": {"16":"icons/icon-16.png","32":"icons/icon-32.png","48":"icons/icon-48.png","128":"icons/icon-128.png"},
  "web_accessible_resources": [{"resources":["panel.html","panel.css","panel.js"],"matches":["https://app.slack.com/*"]}],
  "content_security_policy": {"extension_pages":"script-src 'self'; object-src 'none'; base-uri 'none'; connect-src https://api.openai.com"}
}
